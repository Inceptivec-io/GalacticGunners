{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://galacticgunners.inceptivec.com/contracts/leaderboard-entry.schema.json",
  "title": "LeaderboardEntry",
  "type": "object",
  "required": ["rank", "run_id", "display_name", "score", "campaign_level_reached", "victory", "accepted_at"],
  "properties": {
    "run_id": { "type": "string", "format": "uuid" },
    "display_name": { "type": "string", "minLength": 1, "maxLength": 64 },
    "score": { "type": "integer", "minimum": 0 },
    "rank": { "type": "integer", "minimum": 1 },
    "campaign_level_reached": { "type": "integer", "minimum": 1 },
    "victory": { "type": "boolean" },
    "accepted_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
