{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://galacticgunners.inceptivec.com/contracts/score-event.schema.json",
  "title": "ScoreEventSummary",
  "type": "object",
  "properties": {
    "laserTargets": { "type": "integer", "minimum": 0 },
