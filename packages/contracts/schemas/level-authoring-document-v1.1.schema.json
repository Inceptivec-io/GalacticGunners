{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inceptivec.io/contracts/galactic-gunners/level-authoring-document-v1.1.schema.json",
  "title": "Galactic Gunners Level Authoring Document",
  "type": "object",
  "required": ["schema_version", "id", "slug", "name", "version", "status", "sequence", "seed", "canvas", "player_spawns", "entities", "formations", "hazard_emitters", "shield_structures", "drop_rules", "objectives", "boarding_anchors", "gameplay", "performance_budget"],
  "properties": {
    "schema_version": { "const": "1.1" },
    "id": { "type": "string", "minLength": 1 },
    "slug": { "type": "string", "pattern": "^[a-z0-9-]{3,64}$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 128 },
    "version": { "type": "integer", "minimum": 1 },
    "status": { "enum": ["DRAFT", "VALIDATED", "PUBLISHED", "SUPERSEDED", "ARCHIVED"] },
    "sequence": { "type": "integer", "minimum": 1 },
    "seed": { "type": "integer" },
    "canvas": {
      "type": "object",
      "required": ["width", "height", "grid_size", "snap_enabled", "background_asset_id"],
      "properties": {
        "width": { "const": 1280 }, "height": { "const": 720 },
        "grid_size": { "enum": [8, 16, 24, 32] }, "snap_enabled": { "type": "boolean" },
        "background_asset_id": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "player_spawns": { "type": "array", "minItems": 1 },
    "entities": { "type": "array", "items": { "$ref": "#/$defs/entity" } },
    "formations": { "type": "array", "items": { "$ref": "#/$defs/formation" } },
    "hazard_emitters": { "type": "array" },
    "shield_structures": { "type": "array" },
    "drop_rules": { "type": "array" },
    "objectives": { "type": "array" },
    "boarding_anchors": { "type": "array", "maxItems": 1 },
    "gameplay": { "type": "object" },
    "performance_budget": { "type": "object" }
  },
  "$defs": {
    "entity": {
      "type": "object",
      "required": ["id", "entity_type", "asset_id", "x", "y", "width", "height", "rotation", "z_index", "behaviour_profile", "enabled", "tags"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "entity_type": { "enum": ["SCOUT", "CRUISER", "DESTROYER", "MOTHERSHIP", "ASTEROID", "COMET", "SHIELD_TILE", "NUKE_PICKUP", "LIFE_PICKUP"] },
        "asset_id": { "type": "string", "minLength": 1 },
        "x": { "type": "number", "minimum": 0, "maximum": 1280 },
        "y": { "type": "number", "minimum": 0, "maximum": 720 },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 },
        "rotation": { "type": "number" }, "z_index": { "type": "number" },
        "behaviour_profile": { "type": "string", "minLength": 1 },
        "enabled": { "type": "boolean" }, "tags": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "formation": {
      "type": "object",
      "required": ["id", "name", "layout", "bounds", "member_ids", "motion_profile", "entry_delay_ms", "repeat"],
      "properties": {
        "id": { "type": "string", "minLength": 1 }, "name": { "type": "string", "minLength": 1 },
        "layout": { "enum": ["GRID", "LINE", "WEDGE", "ARC", "FREEFORM"] },
        "bounds": { "type": "object", "required": ["x", "y", "width", "height"] },
        "member_ids": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
        "motion_profile": { "type": "string", "minLength": 1 },
        "entry_delay_ms": { "type": "integer", "minimum": 0 }, "repeat": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
