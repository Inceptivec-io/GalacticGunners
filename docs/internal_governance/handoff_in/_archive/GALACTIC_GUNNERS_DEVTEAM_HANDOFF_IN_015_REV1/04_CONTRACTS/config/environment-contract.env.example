# Public browser configuration: must stay relative.
NEXT_PUBLIC_API_BASE_URL=/api/v1

# Server/container-only proxy destination. Never expose with NEXT_PUBLIC_ prefix.
INTERNAL_API_ORIGIN=http://backend:8000

POSTGRES_DB=galactic_gunners
POSTGRES_USER=galactic_gunners
POSTGRES_PASSWORD=local-development-only
DATABASE_URL=postgresql://galactic_gunners:local-development-only@db:5432/galactic_gunners
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=local-development-placeholder-change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3002
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3002
DJANGO_CORS_ALLOW_CREDENTIALS=true
DJANGO_DEBUG=true
ENABLE_DJANGO_ADMIN=true
WEB_HOST_PORT=3002
BACKEND_HOST_PORT=8010
SOURCE_SHA=0000000000000000000000000000000000000000
BUILD_ID=local-unset

# Ignored local Founder review credentials. Never commit populated values.
FOUNDER_REVIEW_MODE=true
FOUNDER_REVIEW_USERNAME=
FOUNDER_REVIEW_PASSWORD=
FOUNDER_REVIEW_DISPLAY_NAME=Michael

# Separate optional technical Django-admin account for local recovery only.
DJANGO_LOCAL_SUPERUSER_USERNAME=
DJANGO_LOCAL_SUPERUSER_PASSWORD=

