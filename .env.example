# Local development only. Never commit real secrets.
POSTGRES_DB=galactic_gunners
POSTGRES_USER=galactic_gunners
POSTGRES_PASSWORD=local-development-only
DATABASE_URL=postgresql://galactic_gunners:local-development-only@db:5432/galactic_gunners
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=local-development-placeholder-change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_DEBUG=true
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3002
ENABLE_DJANGO_ADMIN=false
WEB_HOST_PORT=3002
BACKEND_HOST_PORT=8010
NEXT_PUBLIC_API_BASE_URL=/api/v1
INTERNAL_API_ORIGIN=http://backend:8000
FOUNDER_REVIEW_MODE=true
FOUNDER_REVIEW_USERNAME=founder-review
FOUNDER_REVIEW_PASSWORD=replace-with-local-secret
FOUNDER_REVIEW_DISPLAY_NAME=Founder Review
COMMAND_POST_REVIEW_USERNAME=command-post-review
COMMAND_POST_REVIEW_PASSWORD=replace-with-local-secret
COMMAND_POST_REVIEW_DISPLAY_NAME=Command Post Review
COMMAND_POST_REVIEW_ORGANIZATION_SLUG=founder-demo
PLAYER_REVIEW_USERNAME=player-review
PLAYER_REVIEW_PASSWORD=replace-with-local-secret
PLAYER_REVIEW_DISPLAY_NAME=Player Review
DJANGO_LOCAL_SUPERUSER_USERNAME=django-local-admin
DJANGO_LOCAL_SUPERUSER_PASSWORD=replace-with-local-secret
