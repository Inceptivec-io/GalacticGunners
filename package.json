{
  "name": "galactic-gunners-platform",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/web",
    "game"
  ],
  "scripts": {
    "assets:sync": "node scripts/sync-runtime-assets.mjs && node scripts/compile-canonical-sprites.mjs",
    "sprites:compile": "node scripts/compile-canonical-sprites.mjs",
    "test:sprites": "node --test tests/unit/canonical-sprites.test.mjs",
    "web:dev": "npm --workspace apps/web run dev",
    "web:build": "npm --workspace apps/web run build",
    "web:typecheck": "npm --workspace apps/web run typecheck",
    "game:typecheck": "npm --workspace game run typecheck",
    "game:test": "npm --workspace game run test",
    "runtime:verify": "node scripts/verify-v1-slice-runtime.mjs",
    "runtime:hostile": "node scripts/verify-v1-slice-runtime.mjs",
    "runtime:campaign": "node scripts/verify-campaign-progression.mjs",
    "contracts:boarding:validate": "npm run contracts:validate && node scripts/verify-boarding-runtime.mjs",
    "test:boarding": "npm --workspace game run test -- tests/boarding-simulation.test.ts",
    "runtime:boarding": "node scripts/verify-boarding-runtime.mjs",
    "runtime:shooter-baseline": "node scripts/verify-shooter-baseline.mjs",
    "runtime:navigation-and-pause": "node scripts/verify-navigation-and-pause.mjs",
    "runtime:designer-pointer-interaction": "node scripts/verify-designer-pointer-interaction.mjs",
    "runtime:designer-authoring-persistence": "node scripts/verify-designer-authoring-persistence.mjs",
    "runtime:authentication-session": "node scripts/verify-authentication-session.mjs",
    "runtime:boarding-entry-pause-and-abort": "node scripts/verify-boarding-entry-pause-and-abort.mjs",
    "runtime:hazard-direction-rotation-and-destruction": "node scripts/verify-hazard-direction-rotation-and-destruction.mjs",
    "runtime:boarding-combat-exit-and-return": "node scripts/verify-boarding-combat-exit-and-return.mjs",
    "runtime:designer-save-preview-publish": "node scripts/verify-designer-save-preview-publish.mjs",
    "runtime:founder-product-review-matrix": "node scripts/capture-founder-product-review-matrix.mjs",
    "runtime:cross-browser-gameplay": "node scripts/run-cross-browser-gameplay.mjs",
    "h015:closure-audit": "node scripts/verify-h015-evidence-integrity.mjs",
    "h015:closure-attest": "node scripts/generate-h015-closure-attestation.mjs",
    "h015:build-evidence-manifest": "node scripts/build-h015-evidence-manifest.mjs",
    "h015:run-catalogue": "node scripts/run-h015-assurance-catalogue.mjs",
    "h015:build-catalogue-results": "node scripts/build-h015-catalogue-results.mjs",
    "test:h015:intake": "node --test tests/unit/h015-assurance-intake.test.mjs && node scripts/verify-h015-assurance-intake.mjs",
    "test:h015:evidence-integrity": "node --test tests/unit/h015-evidence-identity.test.mjs tests/unit/h015-closure-attestation.test.mjs tests/unit/h015-assurance-catalogue.test.mjs tests/unit/wait-for-http.test.mjs tests/unit/runtime-verifier-lifecycle.test.mjs && node scripts/test-h015-evidence-integrity.mjs && node scripts/test-h015-ci-artifacts.mjs",
    "test:h015:traceability": "node scripts/test-h015-traceability.mjs && node --test tests/unit/h015-qa-boundaries.test.mjs && node scripts/validate-h015-traceability.mjs && node scripts/validate-qa-hook-boundaries.mjs",
    "lint": "eslint apps/web game scripts tests --max-warnings=0",
    "format:check": "prettier --check apps/web/game/GameHost.tsx apps/web/app/globals.css game/src/config/gameConfig.ts game/src/scenes/BootScene.ts game/src/scenes/SplashScene.ts game/src/scenes/MainMenuScene.ts game/src/scenes/Level1Scene.ts tests/e2e docs/assurance eslint.config.mjs playwright.config.ts package.json",
    "test:unit": "npm --workspace game run test",
    "test:component": "vitest run --project component",
    "test:e2e": "playwright test --project=chromium-desktop",
    "test:a11y": "playwright test tests/accessibility --project=chromium-desktop",
    "test:coverage": "vitest run --coverage",
    "runtime:boarding:hostile": "npm run test:boarding && node scripts/verify-boarding-runtime.mjs",
    "contracts:validate": "node scripts/validate-contracts.mjs",
    "quality": "npm run assets:sync && npm run contracts:validate && npm run game:typecheck && npm run game:test && npm run web:typecheck && npm run web:build && npm run lint && npm run format:check && npm run test:h015:intake && npm run test:h015:traceability"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.3",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "jsdom": "^26.1.0",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "sharp": "^0.35.4",
    "vitest": "^3.2.7",
    "yaml": "^2.9.0"
  }
}
