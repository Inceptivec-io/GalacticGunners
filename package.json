{
  "name": "galactic-gunners-platform",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/web",
    "game"
  ],
  "scripts": {
    "assets:sync": "node scripts/sync-runtime-assets.mjs",
    "web:dev": "npm --workspace apps/web run dev",
    "web:build": "npm --workspace apps/web run build",
    "web:typecheck": "npm --workspace apps/web run typecheck",
    "game:typecheck": "npm --workspace game run typecheck",
    "game:test": "npm --workspace game run test",
    "runtime:verify": "node scripts/verify-v1-slice-runtime.mjs",
    "runtime:hostile": "node scripts/verify-v1-slice-runtime.mjs",
    "runtime:campaign": "node scripts/verify-campaign-progression.mjs",
    "contracts:boarding:validate": "npm run contracts:validate && node scripts/verify-boarding-runtime.mjs",
    "test:boarding": "npm --workspace game run test -- tests/boarding-simulation.test.ts",
    "runtime:boarding": "node scripts/verify-boarding-runtime.mjs",
    "runtime:h015:stage1": "node scripts/verify-h015-stage1.mjs",
    "runtime:h015:stage2": "node scripts/verify-h015-stage2-navigation.mjs",
    "runtime:h015:stage3": "node scripts/verify-h015-designer-pointer.mjs",
    "runtime:h015:stage4": "node scripts/verify-h015-stage4-authoring.mjs",
    "runtime:h015:stage9": "node scripts/verify-h015-auth-session.mjs",
    "runtime:h015:boarding": "node scripts/verify-h015-boarding-journey.mjs",
    "runtime:h015:level4-hazards": "node scripts/verify-h015-level4-hazards.mjs",
    "runtime:h015:boarding-success": "node scripts/verify-h015-boarding-success.mjs",
    "runtime:h015:designer-roundtrip": "node scripts/verify-h015-designer-roundtrip.mjs",
    "runtime:h015:review-matrix": "node scripts/capture-h015-review-matrix.mjs",
    "h015:closure-audit": "node scripts/verify-h015-evidence-integrity.mjs",
    "h015:closure-attest": "node scripts/generate-h015-closure-attestation.mjs",
    "h015:build-evidence-manifest": "node scripts/build-h015-evidence-manifest.mjs",
    "test:h015:evidence-integrity": "node scripts/test-h015-evidence-integrity.mjs",
    "test:h015:traceability": "node scripts/test-h015-traceability.mjs && node scripts/validate-h015-traceability.mjs && node scripts/validate-qa-hook-boundaries.mjs",
    "lint": "eslint apps/web game scripts tests --max-warnings=0",
    "format:check": "prettier --check apps/web/game/GameHost.tsx apps/web/app/globals.css game/src/config/gameConfig.ts game/src/scenes/BootScene.ts game/src/scenes/SplashScene.ts game/src/scenes/MainMenuScene.ts game/src/scenes/Level1Scene.ts tests/e2e docs/assurance eslint.config.mjs playwright.config.ts package.json",
    "test:unit": "npm --workspace game run test",
    "test:component": "vitest run --project component",
    "test:e2e": "playwright test --project=chromium-desktop",
    "test:a11y": "playwright test tests/accessibility --project=chromium-desktop",
    "test:coverage": "vitest run --coverage",
    "runtime:boarding:hostile": "npm run test:boarding && node scripts/verify-boarding-runtime.mjs",
    "contracts:validate": "node scripts/validate-contracts.mjs",
    "quality": "npm run assets:sync && npm run contracts:validate && npm run game:typecheck && npm run game:test && npm run web:typecheck && npm run web:build && npm run lint && npm run format:check && npm run test:h015:traceability"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.3",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "vitest": "^3.2.7",
    "yaml": "^2.9.0"
  }
}
